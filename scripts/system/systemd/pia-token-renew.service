[Unit]
Description=Private Internet Access Token Renewal
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot

User=root
EnvironmentFile=/etc/pia/credentials

# Esecuzione esplicita tramite bash per compatibilità SELinux su percorsi home
ExecStart=/usr/bin/bash /home/simone/GitHub/handling-linux/scripts/system/pia/renew-token.sh

# Hardening e isolamento
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only

# Su Bazzite /opt è un symlink a var/opt: includiamo entrambi per garantire i permessi corretti
ReadWritePaths=/opt/piavpn-manual /var/opt/piavpn-manual
