#!/usr/bin/env bash

# ==============================================================================
# pia-ctl: CLI & Helper desktop per gestione PIA WireGuard VPN
# ==============================================================================
# Permette di connettere, disconnettere, commutare (toggle) e interrogare lo
# stato del tunnel WireGuard e del Port Forwarding.
# ==============================================================================

set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

notify() {
    local title="$1"
    local msg="$2"
    local icon="${3:-network-vpn}"
    if command -v notify-send >/dev/null; then
        notify-send -i "$icon" "$title" "$msg" 2>/dev/null || true
    fi
}

cmd="${1:-status}"

case "$cmd" in
    up|start|connect)
        echo -e "${BLUE}Connessione a PIA WireGuard VPN...${NC}"
        sudo systemctl start pia-vpn.service

        # Attesa rapida comparsa interfaccia/porta (max 5s)
        for _ in {1..10}; do
            if [[ -s /run/pia_port ]]; then break; fi
            sleep 0.5
        done

        port=$(cat /run/pia_port 2>/dev/null || cat /opt/piavpn-manual/active_port 2>/dev/null || echo "")
        if [[ -n "$port" ]]; then
            notify "PIA VPN Connessa" "Tunnel WireGuard attivo\nPorta inoltrata: $port" "network-vpn"
            echo -e "${GREEN}Connessione stabilita con successo!${NC}"
            echo -e "Porta assegnata: ${YELLOW}$port${NC}"
        else
            notify "PIA VPN" "Connessione avviata" "network-vpn"
            echo -e "${GREEN}Servizio VPN avviato.${NC}"
        fi
        ;;

    down|stop|disconnect)
        echo -e "${YELLOW}Disconnessione PIA WireGuard VPN...${NC}"
        sudo systemctl stop pia-vpn.service
        notify "PIA VPN Disconnessa" "Il tunnel WireGuard è stato chiuso" "network-vpn-disconnected"
        echo -e "${GREEN}Tunnel disconnesso.${NC}"
        ;;

    restart)
        echo -e "${BLUE}Riavvio servizio PIA VPN...${NC}"
        sudo systemctl restart pia-vpn.service
        sleep 2
        port=$(cat /run/pia_port 2>/dev/null || cat /opt/piavpn-manual/active_port 2>/dev/null || echo "")
        notify "PIA VPN Riavviata" "Porta: ${port:-in assegnazione}" "network-vpn"
        echo -e "${GREEN}Riavvio completato.${NC}"
        ;;

    toggle)
        if systemctl is-active --quiet pia-vpn.service; then
            "$0" down
        else
            "$0" up
        fi
        ;;

    status)
        echo "================================================="
        echo "              Stato PIA WireGuard VPN            "
        echo "================================================="
        if systemctl is-active --quiet pia-vpn.service; then
            echo -e "Stato Servizio:     ${GREEN}ATTIVO (connesso)${NC}"
            if ip link show dev pia &>/dev/null; then
                echo -e "Interfaccia:        ${GREEN}pia (UP)${NC}"
                if command -v wg >/dev/null; then
                    wg_info=$(sudo wg show pia 2>/dev/null || true)
                    endpoint=$(echo "$wg_info" | grep "endpoint:" | awk '{print $2}' || echo "")
                    transfer=$(echo "$wg_info" | grep "transfer:" | sed 's/^[ \t]*//' || echo "")
                    [[ -n "$endpoint" ]] && echo -e "Endpoint Server:    ${BLUE}$endpoint${NC}"
                    [[ -n "$transfer" ]] && echo -e "Traffico:           $transfer"
                fi
            else
                echo -e "Interfaccia:        ${YELLOW}in fase di avvio...${NC}"
            fi

            port=$(cat /run/pia_port 2>/dev/null || cat /opt/piavpn-manual/active_port 2>/dev/null || echo "")
            if [[ -n "$port" ]]; then
                echo -e "Port Forwarding:    ${GREEN}PORTA $port ATTIVA${NC}"
            else
                echo -e "Port Forwarding:    ${YELLOW}in negoziazione...${NC}"
            fi

            echo -n "IP Pubblico VPN:    "
            pub_ip=$(curl -s --max-time 2 https://am.i.mullvad.net/ip 2>/dev/null || curl -s --max-time 2 https://ipinfo.io/ip 2>/dev/null || echo "Impossibile rilevare")
            echo -e "${GREEN}$pub_ip${NC}"
        else
            echo -e "Stato Servizio:     ${RED}DISCONNESSO (inattivo)${NC}"
            echo -e "Interfaccia:        Nessuna"
            echo -e "Port Forwarding:    Nessuna porta attiva"
        fi
        echo "================================================="
        ;;

    status-msg)
        # Formato compatto per notifiche o dialoghi grafici (kdialog)
        if systemctl is-active --quiet pia-vpn.service; then
            port=$(cat /run/pia_port 2>/dev/null || cat /opt/piavpn-manual/active_port 2>/dev/null || echo "In attesa...")
            pub_ip=$(curl -s --max-time 2 https://am.i.mullvad.net/ip 2>/dev/null || echo "N/D")
            echo -e "Stato: CONNESSO\nIP Pubblico: $pub_ip\nPorta Forwardata: $port"
        else
            echo "Stato: DISCONNESSO"
        fi
        ;;

    port)
        port=$(cat /run/pia_port 2>/dev/null || cat /opt/piavpn-manual/active_port 2>/dev/null || echo "")
        if [[ -n "$port" ]]; then
            echo "$port"
        else
            echo "Nessuna porta attiva (VPN disconnessa)" >&2
            exit 1
        fi
        ;;

    *)
        echo "Uso: pia-ctl {up|down|restart|toggle|status|port}"
        exit 1
        ;;
esac
