[Desktop Entry]
Type=Application
Name=PIA VPN
GenericName=Virtual Private Network
Comment=Connetti o disconnetti PIA WireGuard con Port Forwarding
Icon=network-vpn
Exec=pia-ctl toggle
Terminal=false
Categories=Network;Security;
Actions=Connect;Disconnect;Status;

[Desktop Action Connect]
Name=Connetti VPN
Exec=pia-ctl up

[Desktop Action Disconnect]
Name=Disconnetti VPN
Exec=pia-ctl down

[Desktop Action Status]
Name=Visualizza Stato e Porta
Exec=bash -c 'kdialog --title "Stato PIA VPN" --msgbox "$(/home/simone/.local/bin/pia-ctl status-msg)"'
